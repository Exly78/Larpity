# Copied to /etc/larpity.env. Every Larpity service reads it.

# Only Caddy should reach the server directly.
LARPITY_ADDR=127.0.0.1:8080

# The secret the phone page and the AI host put in their URLs as ?token=...
# Generate one with: openssl rand -hex 16
LARPITY_TOKEN=change-me

LARPITY_CLIENT_DIR=/opt/larpity/client
LARPITY_FIRMWARE_DIR=/opt/larpity/firmware

# Recording uses about 0.8 GB per hour of stream. Leave it off while the fake
# phone loops all day; turn it on for real sessions.
#LARPITY_RECORD_DIR=/var/lib/larpity/recordings

RUST_LOG=info
